# updated
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Analyses are read through server routes that strip private fields and
    // enforce the application contract. The Admin SDK is used for persistence.
    match /analyses/{analysisId} {
      allow get, list: if false;
      allow create, update, delete: if false; // System handles these via admin SDK
    }

    // Explorations and generated resources are also server-mediated. Keeping
    // direct client reads disabled prevents collection probing and bypasses.
    match /explorations/{explorationId} {
      allow read, write: if false;
    }

    match /resource_cache/{resourceId} {
      allow read, write: if false;
    }

    // Short-lived encrypted resume/JD payloads are server-only. The Admin
    // SDK creates and deletes them during AI enrichment.
    match /analysis_enrichment_jobs/{analysisId} {
      allow read, write: if false;
    }

    // Profiles: Only readable/writable by owner
    match /profiles/{userId} {
      allow get, write: if isOwner(userId);
    }

    // Active Jobs: Only readable/writable by owner
    match /active_jobs/{userId} {
      allow get, write: if isOwner(userId);
    }

    // Job History: Only readable/writable by owner
    match /job_history/{userId} {
      allow get, write: if isOwner(userId);
      
      match /jobs/{jobId} {
        allow get, write: if isOwner(userId);
      }
    }

    // Share Cards: Publicly readable via ID
    match /share_cards/{cardId} {
      allow get: if true;
      allow write: if false; // System handles these
    }
  }
}
